<Application
    x:Class="WhiteboardProjectBuilder.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WhiteboardProjectBuilder.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WhiteboardProjectBuilder"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    RequestedTheme="Light"
    mc:Ignorable="d">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!--  Other merged dictionaries here  -->
            </ResourceDictionary.MergedDictionaries>
            <!--  Other app resources here  -->
            <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter" />
            <converters:NullableDateTimeToDateTimeOffsetConverter x:Key="NullableDateTimeToDateTimeOffsetConverter" />
            <converters:ShowArchivedButtonTextConverter x:Key="ShowArchivedButtonTextConverter" />
            <converters:SortOrderButtonTextConverter x:Key="SortOrderButtonTextConverter" />

            <Color x:Key="Primary">#512BD4</Color>
            <Color x:Key="MainAccentColor">#00B0F0</Color>
            <Color x:Key="OffWhiteColor">#FDFCFB</Color>

            <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
            <SolidColorBrush x:Key="MainAccentBrush" Color="{StaticResource MainAccentColor}" />
            <SolidColorBrush x:Key="OffWhiteBrush" Color="{StaticResource OffWhiteColor}" />
            <SolidColorBrush x:Key="WhiteBrush" Color="White" />
            <SolidColorBrush x:Key="BlackBrush" Color="Black" />

            <AcrylicBrush
                x:Key="HoverOverlayAcrylicBrush"
                FallbackColor="#594A3D2E"
                Opacity=".97"
                TintColor="AntiqueWhite"
                TintOpacity="0.35" />

            <x:Double x:Key="AppFontSize">14</x:Double>

            <Style x:Key="MyLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            </Style>

            <Style x:Key="Action" TargetType="Button">
                <Setter Property="FontSize" Value="{StaticResource AppFontSize}" />
                <Setter Property="Padding" Value="14 10" />
            </Style>

            <Style
                x:Key="PrimaryAction"
                BasedOn="{StaticResource Action}"
                TargetType="Button">
                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
