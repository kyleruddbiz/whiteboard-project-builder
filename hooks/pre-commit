#!/usr/bin/env bash

# Pre-commit hook that runs dotnet format on staged files

echo "Running dotnet format on staged files..."

# Get list of staged C# files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.cs$')

if [ -z "$STAGED_FILES" ]; then
    echo "No C# files staged for commit."
    exit 0
fi

# Run dotnet format on the solution with only the staged files included
# Note: dotnet format works at the solution/project level, not individual files
dotnet format WhiteboardProjectBuilder.sln --include $(echo $STAGED_FILES | tr '\n' ',' | sed 's/,$//')

# Check if dotnet format made any changes
if [ $? -ne 0 ]; then
    echo "dotnet format failed. Please fix the issues and try again."
    exit 1
fi

# Re-stage the formatted files
echo "Re-staging formatted files..."
echo "$STAGED_FILES" | xargs git add

echo "dotnet format completed successfully."
exit 0
