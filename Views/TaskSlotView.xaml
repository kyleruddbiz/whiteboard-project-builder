<UserControl
    x:Class="WhiteboardProjectBuilder.Views.TaskSlotView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WhiteboardProjectBuilder.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:WhiteboardProjectBuilder.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:TaskSlotViewModel}"
    mc:Ignorable="d">

    <!--  Outer dimensions match ProjectItemView so two stacked tasks (400 + 400)  -->
    <!--  print exactly as wide and tall as a single project. Bottom row stays  -->
    <!--  empty when only the top task is present, top-justifying the lone task.  -->
    <Grid Width="502" Height="800">
        <Grid.RowDefinitions>
            <RowDefinition Height="400" />
            <RowDefinition Height="400" />
        </Grid.RowDefinitions>

        <local:TaskItemView Grid.Row="0" ViewModel="{x:Bind ViewModel.TopTask, Mode=OneWay}" />

        <local:TaskItemView
            x:Name="BottomTaskView"
            Grid.Row="1"
            x:Load="{x:Bind ViewModel.HasBottomTask, Mode=OneWay}"
            ViewModel="{x:Bind ViewModel.BottomTask, Mode=OneWay}" />
    </Grid>
</UserControl>
