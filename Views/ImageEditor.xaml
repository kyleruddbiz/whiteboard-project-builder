<UserControl
    x:Class="WhiteboardProjectBuilder.Views.ImageEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="using:WhiteboardProjectBuilder.Enums"
    xmlns:local="using:WhiteboardProjectBuilder.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="W" Invoked="PanAccelerator_Invoked" />
        <KeyboardAccelerator Key="E" Invoked="ZoomAccelerator_Invoked" />
        <KeyboardAccelerator Key="Left" Invoked="ArrowKeyAccelerator_Invoked" />
        <KeyboardAccelerator Key="Right" Invoked="ArrowKeyAccelerator_Invoked" />
        <KeyboardAccelerator Key="Up" Invoked="ArrowKeyAccelerator_Invoked" />
        <KeyboardAccelerator Key="Down" Invoked="ArrowKeyAccelerator_Invoked" />
    </UserControl.KeyboardAccelerators>

    <Grid>
        <Border
            x:Name="Viewport"
            Background="{StaticResource MainAccentBrush}"
            PointerPressed="Viewport_PointerPressed"
            PointerMoved="Viewport_PointerMoved"
            PointerReleased="Viewport_PointerReleased"
            DoubleTapped="Viewport_DoubleTapped">
            <local:ImageViewport
                ImageSource="{x:Bind ImageSource, Mode=OneWay}"
                OffsetX="{x:Bind OffsetX, Mode=OneWay}"
                OffsetY="{x:Bind OffsetY, Mode=OneWay}"
                ZoomFactor="{x:Bind ZoomFactor, Mode=OneWay}" />
        </Border>

        <StackPanel
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0 8 8 0"
            Orientation="Horizontal"
            Spacing="4">
            <Button
                x:Name="PanButton"
                Width="32"
                Height="32"
                Padding="0"
                Click="PanButton_Click"
                ToolTipService.ToolTip="Pan (W)">
                <FontIcon FontSize="16" Glyph="{x:Bind PanIcon}" />
            </Button>
            <Button
                x:Name="ZoomButton"
                Width="32"
                Height="32"
                Padding="0"
                Click="ZoomButton_Click"
                ToolTipService.ToolTip="Zoom (E)">
                <FontIcon FontSize="16" Glyph="{x:Bind ZoomIcon}" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
