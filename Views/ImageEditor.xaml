<UserControl
    x:Class="WhiteboardProjectBuilder.Views.ImageEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="using:WhiteboardProjectBuilder.Enums"
    xmlns:local="using:WhiteboardProjectBuilder.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="W" Invoked="PanAccelerator_Invoked" />
        <KeyboardAccelerator Key="E" Invoked="ZoomAccelerator_Invoked" />
    </UserControl.KeyboardAccelerators>

    <Grid>
        <Border
            x:Name="Viewport"
            Background="#00B0F0"
            BorderBrush="Black"
            BorderThickness="2"
            PointerPressed="Viewport_PointerPressed"
            PointerMoved="Viewport_PointerMoved"
            PointerReleased="Viewport_PointerReleased">
            <Grid x:Name="ClipContainer">
                <!-- Outer layer: Handles panning (translation) -->
                <Grid x:Name="PanContainer" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="PanTransform" />
                    </Grid.RenderTransform>

                    <!-- Inner layer: Handles zooming (scaling) -->
                    <Image
                        x:Name="ImageElement"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="{x:Bind ImageSource, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                        RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="ZoomTransform" />
                        </Image.RenderTransform>
                    </Image>
                </Grid>
            </Grid>
        </Border>

        <StackPanel
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0 8 8 0"
            Orientation="Horizontal"
            Spacing="4">
            <Button
                x:Name="PanButton"
                Width="32"
                Height="32"
                Padding="0"
                Click="PanButton_Click"
                ToolTipService.ToolTip="Pan (W)">
                <FontIcon FontSize="16" Glyph="{x:Bind PanIcon}" />
            </Button>
            <Button
                x:Name="ZoomButton"
                Width="32"
                Height="32"
                Padding="0"
                Click="ZoomButton_Click"
                ToolTipService.ToolTip="Zoom (E)">
                <FontIcon FontSize="16" Glyph="{x:Bind ZoomIcon}" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
