<ContentDialog
    x:Class="WhiteboardProjectBuilder.Views.SaveImageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Save Clipboard Image"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    mc:Ignorable="d">

    <StackPanel Spacing="12">
        <TextBlock Text="Enter a name for the image:" />

        <TextBox
            x:Name="FileNameTextBox"
            PlaceholderText="Enter filename"
            TextChanged="FileNameTextBox_TextChanged" />

        <TextBlock
            x:Name="PreviewTextBlock"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>
