<UserControl
    x:Class="WhiteboardProjectBuilder.Views.WhiteboardItemSelectorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:WhiteboardProjectBuilder.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:WhiteboardItemSelectorViewModel}"
    mc:Ignorable="d">

    <Grid>
        <Border
            Width="502"
            Height="800"
            Background="#FBFCFD"
            BorderBrush="Black"
            BorderThickness="2">
            <Grid Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Header  -->
                <TextBlock
                    Grid.Row="0"
                    Margin="0 20 0 40"
                    HorizontalAlignment="Center"
                    FontSize="36"
                    FontWeight="Bold"
                    Foreground="Black"
                    Text="Select Item Type" />

                <!--  2x2 Button Grid  -->
                <Grid Grid.Row="1" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Project Item Button  -->
                    <Button
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="10"
                        Padding="20"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Command="{x:Bind ViewModel.SelectProjectItemCommand, Mode=OneWay}">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10">
                            <FontIcon FontSize="48" Glyph="&#xE7C3;" />
                            <TextBlock
                                FontSize="18"
                                Text="Project Item"
                                TextAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!--  Goal Item Button (Disabled)  -->
                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="10"
                        Padding="20"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        IsEnabled="False">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10">
                            <FontIcon FontSize="48" Glyph="&#xE734;" />
                            <TextBlock
                                FontSize="18"
                                Text="Goal Item"
                                TextAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!--  Inspiration Item Button (Disabled)  -->
                    <Button
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="10"
                        Padding="20"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        IsEnabled="False">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10">
                            <FontIcon FontSize="48" Glyph="&#xE735;" />
                            <TextBlock
                                FontSize="18"
                                Text="Inspiration"
                                TextAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!--  Empty cell for future expansion  -->
                </Grid>
            </Grid>
        </Border>

        <!--  X Button (top-right)  -->
        <Button
            Width="50"
            Height="50"
            Margin="0 12 12 0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="Transparent"
            BorderThickness="0"
            Command="{x:Bind ViewModel.CancelCommand, Mode=OneWay}">
            <FontIcon FontSize="20" Glyph="&#xE106;" />
        </Button>
    </Grid>
</UserControl>
