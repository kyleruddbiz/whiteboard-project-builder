<UserControl
    x:Class="WhiteboardProjectBuilder.Views.WhiteboardItemSelectorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:WhiteboardProjectBuilder.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:WhiteboardItemSelectorViewModel}"
    mc:Ignorable="d">

    <Grid>
        <Border
            Width="502"
            Height="800"
            Background="{StaticResource OffWhiteBrush}"
            BorderBrush="Black"
            BorderThickness="2">
            <Grid Margin="40" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Project Item Button  -->
                <Button
                    Grid.Column="0"
                    Margin="10"
                    Padding="20"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.SelectProjectItemCommand, Mode=OneWay}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                        <FontIcon FontSize="48" Glyph="&#xE7C3;" />
                        <TextBlock
                            FontSize="18"
                            Text="Project Item"
                            TextAlignment="Center" />
                    </StackPanel>
                </Button>

                <!--  Someday Maybe Button  -->
                <Button
                    Grid.Column="1"
                    Margin="10"
                    Padding="20"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.SelectSomedayMaybeItemCommand, Mode=OneWay}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                        <FontIcon FontSize="48" Glyph="&#xE81C;" />
                        <TextBlock
                            FontSize="18"
                            Text="Someday Maybe"
                            TextAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!--  X Button (top-right)  -->
        <Button
            Width="50"
            Height="50"
            Margin="0 12 12 0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="Transparent"
            BorderThickness="0"
            Command="{x:Bind ViewModel.CancelCommand, Mode=OneWay}">
            <FontIcon FontSize="20" Glyph="&#xE106;" />
        </Button>
    </Grid>
</UserControl>
