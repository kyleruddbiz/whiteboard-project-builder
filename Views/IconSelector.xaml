<UserControl
    x:Class="WhiteboardProjectBuilder.Views.IconSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WhiteboardProjectBuilder.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:StringToImageSourceConverter x:Key="LocalStringToImageSourceConverter" />
    </UserControl.Resources>

    <Grid>
        <Button
            x:Name="SelectorButton"
            Padding="0"
            Click="SelectorButton_Click">
            <Button.Resources>
                <Thickness x:Key="ButtonContentMargin">0</Thickness>
            </Button.Resources>
            <Border
                Width="103"
                BorderBrush="Black"
                BorderThickness="2">
                <Image x:Name="SelectedIconImage" Stretch="Uniform" />
            </Border>
        </Button>

        <Popup x:Name="IconPopup" IsLightDismissEnabled="True">
            <Border
                Padding="12"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                BorderBrush="Black"
                BorderThickness="2">
                <GridView
                    x:Name="IconGridView"
                    MaxWidth="500"
                    SelectionChanged="IconGridView_SelectionChanged"
                    SelectionMode="Single">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="103"
                                BorderBrush="Gray"
                                BorderThickness="2"
                                CornerRadius="4">
                                <Image Source="{Binding IconPath, Converter={StaticResource LocalStringToImageSourceConverter}}" Stretch="Uniform" />
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="4" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>
            </Border>
        </Popup>
    </Grid>
</UserControl>