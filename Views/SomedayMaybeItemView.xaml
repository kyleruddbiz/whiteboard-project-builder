<UserControl
    x:Class="WhiteboardProjectBuilder.Views.SomedayMaybeItemView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WhiteboardProjectBuilder.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:WhiteboardProjectBuilder.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:SomedayMaybeViewModel}"
    mc:Ignorable="d">

    <Grid Width="500" Height="396">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="0 10 0 0">
            <TextBlock
                FontSize="46"
                FontWeight="Bold"
                Foreground="Black"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                TextAlignment="Center" />

            <TextBlock
                FontSize="30"
                Foreground="Black"
                Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                TextAlignment="Center" />
        </StackPanel>

        <Grid
            Grid.Row="1"
            Width="420"
            Height="240"
            Margin="0 20 0 4">
            <local:ImageViewport
                ImageSource="{x:Bind ViewModel.Image, Mode=OneWay}"
                OffsetX="{x:Bind ViewModel.ImageOffsetX, Mode=OneWay}"
                OffsetY="{x:Bind ViewModel.ImageOffsetY, Mode=OneWay}"
                ZoomFactor="{x:Bind ViewModel.ImageZoomFactor, Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="3">
            <TextBlock
                Margin="0 0 14 0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                FontSize="12"
                Foreground="Black"
                Text="{x:Bind ViewModel.CreatedDateDisplay, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
