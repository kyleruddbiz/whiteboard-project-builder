<Page
    x:Class="WhiteboardProjectBuilder.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WhiteboardProjectBuilder.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WhiteboardProjectBuilder.Models"
    xmlns:selectors="using:WhiteboardProjectBuilder.Selectors"
    xmlns:viewmodels="using:WhiteboardProjectBuilder.ViewModels"
    x:Name="PageRoot"
    mc:Ignorable="d">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="V"
            Invoked="PasteAccelerator_Invoked"
            Modifiers="Control" />
    </Page.KeyboardAccelerators>
    <Page.Resources>
        <selectors:GridItemTemplateSelector x:Key="GridItemTemplateSelector">
            <selectors:GridItemTemplateSelector.ProjectTemplate>
                <DataTemplate x:DataType="models:GridItemWrapper">
                    <Grid>
                        <local:ProjectItemView
                            x:Name="ItemView"
                            Margin="10"
                            DataContext="{x:Bind ProjectItem}"
                            EditRequested="ProjectItemView_EditRequested" />
                        <Button
                            Width="50"
                            Height="50"
                            Margin="0 12 12 0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding ViewModel.RemoveProjectCommand, ElementName=PageRoot}"
                            CommandParameter="{x:Bind ProjectItem}">
                            <FontIcon FontSize="20" Glyph="&#xE106;" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </selectors:GridItemTemplateSelector.ProjectTemplate>
            <selectors:GridItemTemplateSelector.AddButtonTemplate>
                <DataTemplate x:DataType="models:GridItemWrapper">
                    <Button
                        Width="502"
                        Height="800"
                        Margin="10"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Black"
                        BorderThickness="2"
                        Command="{Binding ViewModel.AddProjectCommand, ElementName=PageRoot}">
                        <FontIcon FontSize="120" Glyph="&#xE710;" />
                    </Button>
                </DataTemplate>
            </selectors:GridItemTemplateSelector.AddButtonTemplate>
        </selectors:GridItemTemplateSelector>
    </Page.Resources>
    <Page.Content>
        <Grid>
            <ScrollViewer>
                <StackPanel
                    Padding="20"
                    HorizontalAlignment="Center"
                    Spacing="10">

                    <TextBlock
                        Margin="0 20 0 0"
                        HorizontalAlignment="Center"
                        FontSize="64"
                        FontWeight="Bold"
                        Text="Projects" />

                    <Button
                        Margin="0 0 0 20"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.PrintProjectsCommand}"
                        Content="Print Projects" />

                    <GridView
                        HorizontalAlignment="Center"
                        ItemTemplateSelector="{StaticResource GridItemTemplateSelector}"
                        ItemsSource="{x:Bind ViewModel.GridItems, Mode=OneWay}"
                        SelectionChanged="GridView_SelectionChanged"
                        SelectionMode="Single" />

                    <!--<Grid>
                    <local:GoalItemView
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        ViewModel="{x:Bind ViewModel.SampleGoal, Mode=OneWay}" />

                    <Image
                        Margin="20 0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Opacity=".5"
                        Source="/Assets/Examples/GoalSingle.png"
                        Stretch="None" />
                </Grid>

                <local:InspirationItemView ViewModel="{x:Bind ViewModel.SampleInspiration, Mode=OneWay}" />-->
                </StackPanel>
            </ScrollViewer>

            <Canvas
                x:Name="PrintCanvas"
                Margin="-2000 0 0 0"
                Opacity="0" />
        </Grid>
    </Page.Content>
</Page>