<Page
    x:Class="WhiteboardProjectBuilder.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:WhiteboardProjectBuilder.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WhiteboardProjectBuilder.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WhiteboardProjectBuilder.Models"
    xmlns:selectors="using:WhiteboardProjectBuilder.Selectors"
    xmlns:viewmodels="using:WhiteboardProjectBuilder.ViewModels"
    x:Name="PageRoot"
    IsTabStop="True"
    KeyDown="Page_KeyDown"
    KeyUp="Page_KeyUp"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="V"
            behaviors:KeyboardAcceleratorCommandBehavior.Command="{x:Bind ViewModel.PasteImageCommand}"
            behaviors:KeyboardAcceleratorCommandBehavior.CommandParameter="{x:Bind XamlRoot}"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="P"
            behaviors:KeyboardAcceleratorCommandBehavior.Command="{x:Bind ViewModel.PrintWhiteboardItemsCommand}"
            Modifiers="Control" />
    </Page.KeyboardAccelerators>
    <Page.Resources>
        <selectors:GridItemTemplateSelector x:Key="GridItemTemplateSelector">
            <selectors:GridItemTemplateSelector.AddProjectButtonTemplate>
                <DataTemplate x:DataType="models:GridItemWrapper">
                    <Button
                        Width="502"
                        Height="800"
                        Margin="10"
                        Padding="0"
                        Background="{StaticResource OffWhiteBrush}"
                        Command="{Binding ViewModel.AddProjectCommand, ElementName=PageRoot}">
                        <FontIcon FontSize="120" Glyph="&#xE710;" />
                    </Button>
                </DataTemplate>
            </selectors:GridItemTemplateSelector.AddProjectButtonTemplate>
            <selectors:GridItemTemplateSelector.AddTaskButtonTemplate>
                <DataTemplate x:DataType="models:GridItemWrapper">
                    <Button
                        Width="502"
                        Height="400"
                        Margin="10"
                        Padding="0"
                        Background="{StaticResource OffWhiteBrush}"
                        Command="{Binding ViewModel.AddTaskCommand, ElementName=PageRoot}">
                        <FontIcon FontSize="80" Glyph="&#xE710;" />
                    </Button>
                </DataTemplate>
            </selectors:GridItemTemplateSelector.AddTaskButtonTemplate>
            <selectors:GridItemTemplateSelector.ProjectTemplate>
                <DataTemplate x:DataType="models:GridItemWrapper">
                    <Grid>
                        <local:ProjectItemView
                            Margin="10"
                            DataContext="{x:Bind ProjectItem}"
                            EditCommand="{Binding ViewModel.EnterEditModeCommand, ElementName=PageRoot}"
                            ImageReplaceCommand="{Binding ViewModel.ReplaceImageCommand, ElementName=PageRoot}"
                            ReactivateCommand="{Binding ViewModel.ReactivateItemCommand, ElementName=PageRoot}" />
                        <local:RemoveItemButton
                            Margin="0 12 12 0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            ForceRemoveCommand="{Binding ViewModel.ForceRemoveWhiteboardItemCommand, ElementName=PageRoot}"
                            IsCtrlKeyPressed="{Binding IsCtrlPressed, ElementName=PageRoot, Mode=OneWay}"
                            RemoveCommand="{Binding ViewModel.RemoveWhiteboardItemCommand, ElementName=PageRoot}"
                            WhiteboardItem="{x:Bind ProjectItem}" />
                    </Grid>
                </DataTemplate>
            </selectors:GridItemTemplateSelector.ProjectTemplate>
            <selectors:GridItemTemplateSelector.TaskItemTemplate>
                <DataTemplate x:DataType="models:GridItemWrapper">
                    <Grid>
                        <local:TaskItemView
                            Margin="10"
                            EditCommand="{Binding ViewModel.EnterEditModeCommand, ElementName=PageRoot}"
                            ImageReplaceCommand="{Binding ViewModel.ReplaceImageCommand, ElementName=PageRoot}"
                            ReactivateCommand="{Binding ViewModel.ReactivateItemCommand, ElementName=PageRoot}"
                            ViewModel="{x:Bind TaskItem}" />
                        <local:RemoveItemButton
                            Margin="0 12 12 0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            ForceRemoveCommand="{Binding ViewModel.ForceRemoveWhiteboardItemCommand, ElementName=PageRoot}"
                            IsCtrlKeyPressed="{Binding IsCtrlPressed, ElementName=PageRoot, Mode=OneWay}"
                            RemoveCommand="{Binding ViewModel.RemoveWhiteboardItemCommand, ElementName=PageRoot}"
                            WhiteboardItem="{x:Bind TaskItem}" />
                    </Grid>
                </DataTemplate>
            </selectors:GridItemTemplateSelector.TaskItemTemplate>
        </selectors:GridItemTemplateSelector>
    </Page.Resources>
    <Page.Content>
        <Grid
            x:Name="RootGrid"
            Background="#F3EFEA"
            IsTabStop="True"
            KeyDown="Page_KeyDown"
            KeyUp="Page_KeyUp"
            Tapped="RootGrid_Tapped">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel
                Padding="20"
                HorizontalAlignment="Center"
                Spacing="10">

                <TextBlock
                    Margin="0 20 0 0"
                    HorizontalAlignment="Center"
                    FontSize="64"
                    FontWeight="Bold"
                    Text="Whiteboard" />

                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Button Command="{x:Bind ViewModel.PrintWhiteboardItemsCommand}" Content="Print Items" />
                    <Button
                        x:Name="OpenImagesFolderButton"
                        x:Load="{x:Bind ViewModel.Settings.IsDeveloperMode, Mode=OneWay}"
                        Command="{x:Bind ViewModel.OpenImagesFolderCommand}"
                        Content="Open Images Folder" />
                    <Button Command="{x:Bind ViewModel.ToggleShowArchivedCommand}" Content="{x:Bind ViewModel.Settings.ShowArchived, Mode=OneWay, Converter={StaticResource ShowArchivedButtonTextConverter}}" />
                    <Button Command="{x:Bind ViewModel.ToggleSortOrderCommand}" Content="{x:Bind ViewModel.Settings.IsSortDescending, Mode=OneWay, Converter={StaticResource SortOrderButtonTextConverter}}" />
                </StackPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="0 20 0 0">
                <StackPanel HorizontalAlignment="Center" Spacing="20">
                    <TextBlock
                        Margin="20 0 0 0"
                        FontSize="40"
                        FontWeight="SemiBold"
                        Text="Projects" />

                    <GridView
                        x:Name="ProjectsGridView"
                        HorizontalAlignment="Center"
                        IsTabStop="True"
                        ItemTemplateSelector="{StaticResource GridItemTemplateSelector}"
                        ItemsSource="{x:Bind ViewModel.ProjectGridItems, Mode=OneWay}"
                        SelectionChanged="GridView_SelectionChanged"
                        SelectionMode="Single" />

                    <TextBlock
                        Margin="20 20 0 0"
                        FontSize="40"
                        FontWeight="SemiBold"
                        Text="Tasks" />

                    <GridView
                        x:Name="TasksGridView"
                        HorizontalAlignment="Center"
                        IsTabStop="True"
                        ItemTemplateSelector="{StaticResource GridItemTemplateSelector}"
                        ItemsSource="{x:Bind ViewModel.TaskGridItems, Mode=OneWay}"
                        SelectionChanged="GridView_SelectionChanged"
                        SelectionMode="Single" />
                </StackPanel>
            </ScrollViewer>

            <ProgressRing
                x:Name="LoadingIndicator"
                Grid.Row="1"
                Width="60"
                Height="60"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                x:Load="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                IsActive="True" />

            <Canvas
                x:Name="PrintCanvas"
                Margin="-2000 0 0 0"
                Opacity="0" />
        </Grid>
    </Page.Content>
</Page>
