<Page
    x:Class="WhiteboardProjectBuilder.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WhiteboardProjectBuilder.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:WhiteboardProjectBuilder.ViewModels"
    mc:Ignorable="d">
    <Page.Content>
        <Grid>
            <ScrollViewer>
                <StackPanel
                    Padding="20"
                    HorizontalAlignment="Center"
                    Spacing="10">

                    <TextBlock
                        Margin="0 20 0 0"
                        HorizontalAlignment="Center"
                        FontSize="64"
                        FontWeight="Bold"
                        Text="Projects" />

                    <Button
                        Margin="0 0 0 20"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.PrintProjectsCommand}"
                        Content="Print Projects" />

                    <GridView ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:ProjectItemViewModel">
                                <local:ProjectItemView Margin="10" DataContext="{x:Bind}" />
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!--<Grid>
                    <local:GoalItemView
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        ViewModel="{x:Bind ViewModel.SampleGoal, Mode=OneWay}" />

                    <Image
                        Margin="20 0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Opacity=".5"
                        Source="/Assets/Examples/GoalSingle.png"
                        Stretch="None" />
                </Grid>

                <local:InspirationItemView ViewModel="{x:Bind ViewModel.SampleInspiration, Mode=OneWay}" />-->
                </StackPanel>
            </ScrollViewer>

            <Canvas
                x:Name="PrintCanvas"
                Margin="-2000 0 0 0"
                Opacity="0" />
        </Grid>
    </Page.Content>
</Page>