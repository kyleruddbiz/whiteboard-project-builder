<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="WhiteboardProjectBuilder.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WhiteboardProjectBuilder.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Content>
        <ScrollViewer>
            <StackPanel
                HorizontalAlignment="Center"
                Spacing="40"
                Padding="20">

                <TextBlock
                    Text="Whiteboard Item Examples"
                    FontSize="32"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    Margin="0 20 0 20" />

                <!-- Project Item Example -->
                <local:ProjectItemView ViewModel="{x:Bind ViewModel.SampleProject, Mode=OneWay}" />

                <!-- Goal Item Example -->
                <local:GoalItemView ViewModel="{x:Bind ViewModel.SampleGoal, Mode=OneWay}" />

                <!-- Inspiration Item Example -->
                <local:InspirationItemView ViewModel="{x:Bind ViewModel.SampleInspiration, Mode=OneWay}" />

            </StackPanel>
        </ScrollViewer>
    </Page.Content>
</Page>
