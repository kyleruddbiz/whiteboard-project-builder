                    <Image
                        Margin="20 0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Opacity=".5"
                        Source="/Assets/Examples/GoalSingle.png"
                        Stretch="None" />
                </Grid>

                <local:InspirationItemView ViewModel="{x:Bind ViewModel.SampleInspiration, Mode=OneWay}" />-->
