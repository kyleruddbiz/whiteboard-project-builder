<UserControl
    x:Class="WhiteboardProjectBuilder.Views.SomedayMaybePairEditView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WhiteboardProjectBuilder.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:WhiteboardProjectBuilder.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:SomedayMaybePairViewModel}"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
    </UserControl.KeyboardAccelerators>

    <Border
        Width="502"
        Height="800"
        BorderBrush="#005FBA"
        BorderThickness="4">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Top Item Section  -->
                <StackPanel Grid.Row="0" Spacing="8">
                    <local:SomedayMaybeEditView
                        x:Name="TopItemEditor"
                        ImageReplaceRequested="TopItemEditor_ImageReplaceRequested"
                        ViewModel="{x:Bind ViewModel.TopItem, Mode=OneWay}" />
                </StackPanel>

                <!--  Separator  -->
                <Border Grid.Row="1" Background="Black" />

                <!--  Bottom Item Section  -->
                <Grid Grid.Row="2">
                    <!--  Add Bottom Item Button  -->
                    <Button
                        x:Name="AddBottomButton"
                        x:Load="{x:Bind ViewModel.ShowAddBottomButton, Mode=OneWay}"
                        Margin="40"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Command="{x:Bind ViewModel.AddBottomItemCommand}">
                        <StackPanel Spacing="8">
                            <FontIcon FontSize="48" Glyph="&#xE710;" />
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="Add Bottom Item" />
                        </StackPanel>
                    </Button>

                    <!--  Bottom Item Editor  -->
                    <local:SomedayMaybeEditView
                        x:Name="BottomItemEditor"
                        x:Load="{x:Bind ViewModel.HasBottomItem, Mode=OneWay}"
                        ImageReplaceRequested="BottomItemEditor_ImageReplaceRequested"
                        ViewModel="{x:Bind ViewModel.BottomItem, Mode=OneWay}" />
                </Grid>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
