<UserControl
    x:Class="WhiteboardProjectBuilder.Views.RemoveItemButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        Width="58"
        Height="58"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
        <!--  Radial glow effect (visible only when Ctrl pressed on non-archived items)  -->
        <Ellipse
            x:Name="CtrlGlowEllipse"
            Width="32"
            Height="32"
            Margin="0 0 2 1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Opacity="0">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="#80DC143C" />
                    <GradientStop Offset="0.6" Color="#40DC143C" />
                    <GradientStop Offset="1.0" Color="#00DC143C" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!--  Main X button  -->
        <Button
            x:Name="RemoveButton"
            Width="50"
            Height="50"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Click="RemoveButton_Click">
            <FontIcon FontSize="20" Glyph="&#xE106;" />
        </Button>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ModifierStates">
                <VisualState x:Name="Normal">
                    <VisualState.Setters>
                        <Setter Target="CtrlGlowEllipse.Opacity" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CtrlPressed">
                    <VisualState.Setters>
                        <Setter Target="CtrlGlowEllipse.Opacity" Value="1" />
                    </VisualState.Setters>
                    <VisualState.Storyboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="CtrlGlowEllipse"
                                Storyboard.TargetProperty="Opacity"
                                To="1"
                                Duration="0:0:0.1" />
                        </Storyboard>
                    </VisualState.Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
