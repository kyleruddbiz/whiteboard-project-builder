<UserControl
    x:Class="WhiteboardProjectBuilder.Views.ProjectItemView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:WhiteboardProjectBuilder.Helpers"
    xmlns:local="using:WhiteboardProjectBuilder.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:WhiteboardProjectBuilder.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:ProjectItemViewModel}"
    mc:Ignorable="d">

    <Grid>
        <!--  Readonly View  -->
        <Grid x:Name="ReadonlyView" x:Load="{x:Bind Not(ViewModel.IsEditing), Mode=OneWay}">
            <Border
                Width="502"
                Height="800"
                Background="{x:Bind ViewModel.IsArchived, Mode=OneWay, Converter={StaticResource ArchivedBackgroundConverter}}"
                BorderBrush="Black"
                BorderThickness="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Padding="0 10 0 0">
                        <TextBlock
                            FontSize="46"
                            FontWeight="Bold"
                            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                            TextAlignment="Center" />

                        <TextBlock
                            FontSize="30"
                            Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                            TextAlignment="Center" />
                    </StackPanel>

                    <Grid
                        Grid.Row="1"
                        Width="420"
                        Height="360"
                        Margin="0 38 0 0"
                        VerticalAlignment="Top">
                        <local:ImageViewport
                            ImageSource="{x:Bind ViewModel.Image, Mode=OneWay}"
                            OffsetX="{x:Bind ViewModel.ImageOffsetX, Mode=OneWay}"
                            OffsetY="{x:Bind ViewModel.ImageOffsetY, Mode=OneWay}"
                            Scale="{x:Bind ViewModel.ImageScale, Mode=OneWay}" />
                    </Grid>

                    <StackPanel
                        Grid.Row="2"
                        Height="228"
                        Margin="0 8 0 0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">

                        <Border BorderBrush="Black" BorderThickness="2">
                            <Image Source="{x:Bind ViewModel.SizeIcon, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="Uniform" />
                        </Border>

                        <Border BorderBrush="Black" BorderThickness="2">
                            <Image Source="{x:Bind ViewModel.ValueIcon, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="Uniform" />
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="4">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="30"
                            FontWeight="Bold"
                            Foreground="DarkRed">
                            <Run Text="{x:Bind ViewModel.DatePrefix, Mode=OneWay}" />
                            <Run Text="{x:Bind ViewModel.DateDisplay, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock
                            Margin="0 0 8 -4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            FontSize="12"
                            Foreground="Black"
                            Text="{x:Bind ViewModel.CreatedDateDisplay, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Border>

            <!--  Hover Overlay  -->
            <Border
                Background="Transparent"
                PointerEntered="Overlay_PointerEntered"
                PointerExited="Overlay_PointerExited"
                Tapped="Overlay_Tapped">
                <Border
                    x:Name="HoverIndicator"
                    Background="Black"
                    Opacity="0">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="80"
                        Foreground="White"
                        Glyph="&#xE70F;" />
                </Border>
            </Border>
        </Grid>

        <!--  Edit View  -->
        <Grid x:Name="EditView" x:Load="{x:Bind ViewModel.IsEditing, Mode=OneWay}">
            <local:ProjectItemEditView
                DataContext="{x:Bind ViewModel, Mode=OneWay}"
                ImageReplaceRequested="ProjectItemEditView_ImageReplaceRequested" />
        </Grid>
    </Grid>
</UserControl>