<UserControl
    x:Class="WhiteboardProjectBuilder.Views.FloatingLabelTextBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsTabStop="False"
    mc:Ignorable="d">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="FloatStates">
                <VisualState x:Name="Resting">
                    <VisualState.Setters>
                        <Setter Target="FloatingLabel.Foreground" Value="{ThemeResource TextControlPlaceholderForeground}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Floating">
                    <VisualState.Setters>
                        <Setter Target="FloatingLabel.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="LabelTransform"
                            Storyboard.TargetProperty="TranslateX"
                            To="0"
                            Duration="0:0:0.15">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation
                            Storyboard.TargetName="LabelTransform"
                            Storyboard.TargetProperty="TranslateY"
                            To="0"
                            Duration="0:0:0.15">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <TextBox
            x:Name="InnerTextBox"
            MinHeight="36"
            Margin="0 22 0 0"
            Padding="12 8 12 8"
            AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
            FontSize="14"
            GotFocus="InnerTextBox_FocusChanged"
            LostFocus="InnerTextBox_FocusChanged"
            Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock
            x:Name="FloatingLabel"
            VerticalAlignment="Top"
            FontSize="14"
            Foreground="{ThemeResource TextControlPlaceholderForeground}"
            IsHitTestVisible="False"
            Text="{x:Bind Label, Mode=OneWay}">
            <TextBlock.RenderTransform>
                <CompositeTransform x:Name="LabelTransform" TranslateX="12" TranslateY="30" />
            </TextBlock.RenderTransform>
        </TextBlock>
    </Grid>
</UserControl>
